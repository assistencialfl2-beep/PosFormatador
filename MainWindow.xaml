<Window x:Class="PosFormatador.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PosFormatador - Gerenciador de Drivers e Programas" Height="680" Width="980"
        WindowStartupLocation="CenterScreen" Background="#1E1E1E">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="130"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Assistente de Drivers e Pós-Formatação" 
                   FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,15"/>

        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
            <Button x:Name="BtnScanHardware" Content="🔍 Escanear Hardware" Click="BtnScanHardware_Click" 
                    Padding="10,6" Margin="0,0,8,0" Background="#0E639C" Foreground="White" FontWeight="SemiBold"/>
            
            <CheckBox x:Name="ChkOnlyIssues" Content="Apenas sem driver / erro" 
                      Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,12,0" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
            
            <Button x:Name="BtnAutoDrivers" Content="🌐 Baixar Drivers (Auto)" Click="BtnAutoDrivers_Click" 
                    Padding="10,6" Margin="0,0,8,0" Background="#D97706" Foreground="White" FontWeight="SemiBold"/>

            <Button x:Name="BtnInstallInf" Content="📁 Instalar Driver Local (.INF)" Click="BtnInstallInf_Click" 
                    Padding="10,6" Margin="0,0,8,0" Background="#238636" Foreground="White" FontWeight="SemiBold"/>

            <Button x:Name="BtnRunWinget" Content="⚡ Instalar Programas (Winget/Office)" Click="BtnRunWinget_Click" 
                    Padding="10,6" Background="#6E40C9" Foreground="White" FontWeight="SemiBold"/>
        </WrapPanel>

        <DataGrid Grid.Row="2" x:Name="GridDevices" AutoGenerateColumns="False" 
                  IsReadOnly="True" Background="#252526" Foreground="White" 
                  BorderBrush="#3F3F46" RowBackground="#2D2D30" AlternatingRowBackground="#252526"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#3F3F46">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Dispositivo" Binding="{Binding Name}" Width="2*"/>
                <DataGridTextColumn Header="Hardware ID (VEN / DEV)" Binding="{Binding HardwareId}" Width="2*"/>
                <DataGridTemplateColumn Header="Status" Width="1.5*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StatusDisplay}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#4EC9B0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasDriverIssue}" Value="True">
                                                <Setter Property="Foreground" Value="#F14C4C"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" Text="Log de Operações:" Foreground="#AAAAAA" Margin="0,10,0,4"/>

        <TextBox Grid.Row="4" x:Name="TxtLog" Background="#0C0C0C" Foreground="#00FF66" 
                 FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" 
                 VerticalScrollBarVisibility="Auto" IsReadOnly="True"/>
    </Grid>
</Window>
